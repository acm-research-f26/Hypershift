{
 "study": "FB (feature benchmark), prospective test",
 "frozen_on": "2026-10-22",
 "freeze_date_rule": "score only signal dates > 2026-10-22",
 "horizon": 5,
 "min_days": 250,
 "selection": {
  "rule": "highest pooled neutral RankIC 2019-2023 among h=5 Ridge/LightGBM arms of Tasks 4-6; ties within 0.001 -> Ridge",
  "winner": "lgbm:rich:residual",
  "winner_pooled_neutral_RankIC": 0.0127,
  "runner_up": "ridge:lags (+0.0115)",
  "caveat": "winner of 17 arms on inspected years: expect its prospective value to be lower (selection bias)"
 },
 "arms": {
  "frozen": {
   "model": "lgbm",
   "features": "rich",
   "target": "residual",
   "repr": "cs_z",
   "params": {
    "n_estimators": 50
   },
   "params_rule": "median of selected best_iteration 2019-2023 = median(40, 20, 300, 90, 50)"
  },
  "ridge_rich": {
   "model": "ridge",
   "features": "rich",
   "target": "raw",
   "repr": "cs_z",
   "params": {
    "alpha": 1000
   },
   "params_rule": "median of selected alpha 2019-2023 = median(10, 0.1, 1000, 1000, 1000)"
  },
  "reversal16": {
   "model": "block",
   "features": "reversal16"
  },
  "random": {
   "model": "random",
   "seed": 7
  }
 },
 "primary": [
  "frozen",
  "reversal16"
 ],
 "primary_rule": "two-sided stationary bootstrap (block 10, B 5000) on the daily neutral-RankIC difference over all post-freeze signal dates with mature labels; SUPPORTED if p < 0.05 and the CI excludes 0; evaluated once, when >= min_days exist",
 "secondary": [
  "frozen vs 0",
  "frozen - ridge_rich"
 ],
 "mde_at_min_days": 0.046,
 "mde_source": "docs/featbench_20261022/POWER.md",
 "training": "all signals whose 5-day label matures on or before 2026-10-22 (includes 2015-2026 data); no validation step; no FB metric is computed before the freeze",
